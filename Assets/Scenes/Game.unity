  _tutorialText: {fileID: 826101587}
  _closeButton: {fileID: 81350107}
  _tutorialMessage: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u0432 CODEBREAKER: Infection Protocol!\n\n\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\n\u2022
    WASD - \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435\n\u2022 \u041C\u044B\u0448\u044C
    - \u041E\u0441\u043C\u043E\u0442\u0440\n\u2022 \u041B\u041A\u041C - \u0421\u0442\u0440\u0435\u043B\u044C\u0431\u0430\n\u2022
    \u041F\u0440\u043E\u0431\u0435\u043B - \u041F\u0440\u044B\u0436\u043E\u043A\n\n\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435
    \u043A \u043F\u043E\u0440\u0442\u0430\u043B\u0443, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443!"
  _showOnStart: 1
